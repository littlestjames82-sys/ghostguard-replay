{"rules":[{"effect":"deny","id":"no-spend-ever","locked":true,"note":"locked: no agent spends, ever","when":"permission_class == 'SPEND'"},{"effect":"deny","id":"no-delete-ever","locked":true,"note":"locked: no agent deletes, ever","when":"permission_class == 'DELETE'"},{"effect":"deny","id":"no-deploy-ever","locked":true,"note":"NEW locked rule in the tightened draft: deploys are denied outright","when":"permission_class == 'DEPLOY'"},{"effect":"hand_off","handoff_to":"owner","id":"publish-handoff","when":"permission_class == 'PUBLISH'"},{"effect":"ask","id":"comms-ask","when":"permission_class == 'COMMUNICATE'"},{"effect":"ask","id":"routine-submit-ask","when":"initiator == 'routine' && permission_class == 'NETWORK_WRITE'"},{"effect":"ask","id":"routine-reads-ask","note":"NEW in the tightened draft: routine-initiated reads ask first","when":"initiator == 'routine' && permission_class == 'READ'"},{"effect":"pre_approved","id":"routine-deploy-preapproved","when":"initiator == 'routine' && permission_class == 'DEPLOY'"},{"effect":"pre_approved","id":"docs-write-preapproved","when":"kind == 'fs.write'"},{"effect":"allow","id":"allow-reads","when":"permission_class == 'READ'"}]}